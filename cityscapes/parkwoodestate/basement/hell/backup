  <!-- ✅ DIALOG TYPEWRITER SCRIPT -->
  <script>
    const dialogLines = [
      "Hello there.",
      "Nice to see you.",
      "Good luck on your journey.",
      "I hope you find your way.",
      "He did this to me.",
      "Don't let him see you."
    ];

    const typingSpeed = 250;

    let dialogIndex = 0;
    let charIndex = 0;
    let isTyping = false;

    const dialogBox = document.getElementById("dialog");
    const dialogText = document.getElementById("dialogText");

    function typeLine(line) {
      isTyping = true;
      dialogText.textContent = "";
      charIndex = 0;

      function typeChar() {
        if (charIndex < line.length) {
          dialogText.textContent += line.charAt(charIndex);
          charIndex++;
          setTimeout(typeChar, typingSpeed);
        } else {
          isTyping = false;
        }
      }

      typeChar();
    }

    function showDialog() {
      dialogIndex = 0;
      dialogBox.hidden = false;
      typeLine(dialogLines[dialogIndex]);
    }

    function nextLine() {
      if (isTyping) {
        // Instantly finish current line
        dialogText.textContent = dialogLines[dialogIndex];
        isTyping = false;
        return;
      }

      dialogIndex++;

      if (dialogIndex < dialogLines.length) {
        typeLine(dialogLines[dialogIndex]);
      } else {
        dialogBox.hidden = true;
      }
    }
  </script>

